{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "identity",
	"account_id": "1044a3131c99356eba069325d3be3788",
	"compatibility_date": "2026-06-25",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"ORIGIN": "https://identity.southbag.cc"
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "identity",
			"database_id": "bbbcde95-de11-4062-8006-18b68cc8ed89"
		}
	],
	// Unfreeze fees are taken from Southbag Online Banking through its Billing entrypoint, and the
	// freeze state is mirrored back to Banking's local status through the same binding. Deploy
	// banking (with setStatus) first. See src/lib/server/banking.ts.
	"services": [{ "binding": "BANKING", "service": "southbag-online-banking", "entrypoint": "Billing" }],
	// Optional INTERNAL_API_SECRETS_NEXT has the same JSON format. Set it first to overlap
	// new service keys with the unchanged original map, then switch service credentials.
	// `wrangler secret put INTERNAL_API_SECRETS` with JSON like
	// {"southbag-git": "...", "southbag-online-banking": "...", "backfill": "..."} — one secret per
	// service that reports or reads freezes (see src/routes/api/internal/freeze/+server.ts).
	// The same value goes to each service as IDENTITY_INTERNAL_SECRETS with only its own entry.
}
